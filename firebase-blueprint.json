        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["employeeCode", "name", "email", "department", "position"]
    },
    "Attendance": {
      "title": "HRIS Attendance",
      "description": "Employee attendance logs.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeeCode": { "type": "string" },
        "date": { "type": "string" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "status": { "type": "string" },
        "hoursWorked": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "workLocation": { "type": "string" }
      },
      "required": ["employeeId", "date", "status"]
    },
    "LeaveRequest": {
      "title": "HRIS Leave Request",
      "description": "Leave & permission requests.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalDays": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["employeeId", "leaveType", "startDate", "endDate", "status"]
    },
    "Payroll": {
      "title": "HRIS Payroll",
      "description": "Monthly employee payroll records.",
      "type": "object",
      "properties": {
        "payrollCode": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "periodName": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "baseSalary": { "type": "number" },
        "netSalary": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["payrollCode", "month", "year", "employeeId", "netSalary", "paymentStatus"]
    },
    "CompanyProfile": {
      "title": "Company Profile & Identity",
      "description": "Tenant enterprise identity, uploaded logo, address, and legal entity profile.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "legalName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "taxId": { "type": "string" },
        "signatoryName": { "type": "string" },
        "signatoryTitle": { "type": "string" },
        "currency": { "type": "string" }
      },
      "required": ["companyName", "legalName", "address", "signatoryName", "signatoryTitle"]
    }
  },
  "firestoreRules": {
    "userRule": "Allow authenticated users to read and update their own user record or internal collections.",
    "invitationRule": "Authenticated users can read invitations; Admins can write invitations.",
    "tenantRule": "Authenticated users can read/write shared tenant data."
  }
}
