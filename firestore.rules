rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Invitations collection - read allowed for verifying codes
    match /invitations/{invitationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Single Tenant CRM & HRIS shared collections
    match /companies/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /quotations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /contacts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /leads/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /deals/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /tasks/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /activities/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /pipelineStages/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /employees/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /attendances/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /leaveRequests/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /payrolls/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
